# ==============================================================================
# Global Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure as required for your environment.
# Note: Pydantic Settings on the backend will validate these keys at boot.
# ==============================================================================

# Core System
ENVIRONMENT=development
PROJECT_NAME="Real-Time Analytics SaaS Platform"

# Backend Configuration
PORT=8000
LOG_LEVEL=DEBUG

# Database Configuration (PostgreSQL Async)
# Local Docker Compose defaults:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/analytics
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Cache & Message Broker Configuration
REDIS_URL=redis://redis:6379/0

# Authentication & Security
# Note: For production, generate a high-entropy 256-bit key (e.g., `openssl rand -hex 32`)
JWT_SECRET_KEY=4eb83ea7483842be7c51486d34e2c81729094593cbce6323cf106b3e9447e112
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Setup (JSON Array of allowed domains)
CORS_ORIGINS='["http://localhost:3000"]'

# Background Processing (Celery)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# API & Ingestion Rate Limits
RATE_LIMIT_PER_MINUTE=100
